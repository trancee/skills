{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Skills package audit result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "valid", "errors", "warnings"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "package": {
      "type": "string"
    },
    "valid": {
      "type": "boolean"
    },
    "errors": {
      "$ref": "#/$defs/issues"
    },
    "warnings": {
      "$ref": "#/$defs/issues"
    }
  },
  "$defs": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "message"],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
